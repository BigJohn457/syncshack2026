# Copy this file to .env and replace every placeholder locally. Never commit .env.
FLASK_ENV=development
SECRET_KEY=replace-this-in-production
HOST=127.0.0.1
PORT=8000
DB_HOST=your-database-host
DB_PORT=25060
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_SSL_CA=ca-certificate.crt
API_TIMEZONE=Australia/Sydney
LOG_FILE=app.log
SPACES_ACCESS_KEY_ID=your-spaces-access-key
SPACES_SECRET_ACCESS_KEY=your-spaces-secret-key
SPACES_REGION=syd1
SPACES_BUCKET=mg-kopi
SPACES_FOLDER=personal/hey
SPACES_ENDPOINT_URL=https://syd1.digitaloceanspaces.com
SPACES_PUBLIC_BASE_URL=https://mg-kopi.syd1.digitaloceanspaces.com
MAX_IMAGE_UPLOAD_BYTES=10485760
